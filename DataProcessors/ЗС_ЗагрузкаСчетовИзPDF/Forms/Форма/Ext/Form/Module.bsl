#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайлы(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.МножественныйВыбор = Истина;
	Диалог.Фильтр = "Документы PDF (*.pdf)|*.pdf";
	Диалог.Заголовок = "Счета и УПД, можно несколько";
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораФайловPDF", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайловPDF(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПоместитьСписокФайлов(ВыбранныеФайлы);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталог(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Каталог с PDF счетов и УПД";
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораКаталога", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКаталога(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Найденные = НайтиФайлы(ВыбранныеФайлы[0], "*.pdf", Истина);
	Если Найденные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "В каталоге нет файлов PDF.");
		Возврат;
	КонецЕсли;

	Имена = Новый Массив;
	Для Каждого Файл Из Найденные Цикл
		Имена.Добавить(Файл.ПолноеИмя);
	КонецЦикла;
	ПоместитьСписокФайлов(Имена);

КонецПроцедуры

&НаКлиенте
Процедура ПоместитьСписокФайлов(ПолныеИмена)

	Описания = Новый Массив;
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		Описания.Добавить(Новый ОписаниеПередаваемогоФайла(ПолноеИмя));
	КонецЦикла;

	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайлов", ЭтотОбъект);
	НачатьПомещениеФайловНаСервер(Оповещение, Новый ОписаниеОповещения("ХодПомещенияФайлов", ЭтотОбъект), , Описания, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ХодПомещенияФайлов(ПомещаемыйФайл, Помещено, ОтказОтПомещенияФайла, ДополнительныеПараметры) Экспорт

	Имя = "";
	Если ПомещаемыйФайл <> Неопределено Тогда
		Имя = ПомещаемыйФайл.Имя;
	КонецЕсли;
	Состояние("Передача PDF" + ?(ЗначениеЗаполнено(Имя), ": " + Имя, ""));

КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайлов(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПомещенныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Индекс = 0;
	Всего = ПомещенныеФайлы.Количество();
	Разобрано = 0;
	Ошибок = 0;
	Для Каждого ПомещенныйФайл Из ПомещенныеФайлы Цикл
		Индекс = Индекс + 1;
		Адрес = АдресПомещенногоФайла(ПомещенныйФайл);
		Если Не ЗначениеЗаполнено(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		ИмяФайла = ИмяПомещенногоФайла(ПомещенныйФайл);
		Состояние("Разбор " + Формат(Индекс, "ЧГ=0") + " из " + Формат(Всего, "ЧГ=0") + ": " + ИмяФайла);
		Если ДобавитьФайлНаСервере(Адрес, ИмяФайла) Тогда
			Разобрано = Разобрано + 1;
		Иначе
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;

	Состояние("Готово: разобрано " + Формат(Разобрано, "ЧГ=0") + ", с ошибкой " + Формат(Ошибок, "ЧГ=0"));

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументы(Команда)

	Текст = СоздатьДокументыНаСервере();
	Если ЗначениеЗаполнено(Текст) Тогда
		ПоказатьПредупреждение(, Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)

	Файлы.Очистить();
	Протокол = "";

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция АдресПомещенногоФайла(ПомещенныйФайл)

	Попытка
		Если ПомещенныйФайл.ПомещениеФайлаОтменено Тогда
			Возврат "";
		КонецЕсли;
	Исключение
		Адрес = "";
	КонецПопытки;

	Попытка
		Возврат ПомещенныйФайл.Адрес;
	Исключение
		Адрес = "";
	КонецПопытки;

	Попытка
		Возврат ПомещенныйФайл.Хранение;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ИмяПомещенногоФайла(ПомещенныйФайл)

	ИмяФайла = "";
	Попытка
		ИмяФайла = ПомещенныйФайл.СсылкаНаФайл.Имя;
	Исключение
		ИмяФайла = "";
	КонецПопытки;
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		Попытка
			ИмяФайла = ПомещенныйФайл.Имя;
		Исключение
			ИмяФайла = "файл.pdf";
		КонецПопытки;
	КонецЕсли;
	Возврат ИмяФайла;

КонецФункции

&НаСервере
Функция ДобавитьФайлНаСервере(Адрес, ИмяФайла)

	Если Не ПравоДоступа("Использование", Метаданные.Обработки.ЗС_ЗагрузкаСчетовИзPDF) Тогда
		ВызватьИсключение "Недостаточно прав. Назначьте роль «Загрузка счетов и УПД из PDF».";
	КонецЕсли;

	Для Каждого УжеЕсть Из Файлы Цикл
		Если НРег(УжеЕсть.ИмяФайла) = НРег(ИмяФайла) И УжеЕсть.Статус <> "Ошибка" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	СтрокаФайла = Файлы.Добавить();
	СтрокаФайла.ИмяФайла = ИмяФайла;
	СтрокаФайла.СоздатьСчет = Истина;
	СтрокаФайла.СоздатьУПД = Истина;

	Попытка
		ДанныеФайла = ПолучитьИзВременногоХранилища(Адрес);
		ТекстJSON = ЗС_ЗагрузкаСчетовСервер.РазобратьPDF(ДанныеФайла);
		СтрокаФайла.Данные = ТекстJSON;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстJSON);
		Данные = ПрочитатьJSON(Чтение);
	Исключение
		СтрокаФайла.Статус = "Ошибка";
		СтрокаФайла.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		СтрокаФайла.Статус = "Ошибка";
		СтрокаФайла.Ошибка = "Ответ разбора не является JSON.";
		Возврат Ложь;
	КонецЕсли;

	Если Данные.Свойство("Ошибка") И ЗначениеЗаполнено(Данные.Ошибка) Тогда
		СтрокаФайла.Статус = "Ошибка";
		СтрокаФайла.Ошибка = Данные.Ошибка;
		Возврат Ложь;
	КонецЕсли;

	СтрокаФайла.Вид = Данные.Вид;
	СтрокаФайла.Номер = Данные.Номер;
	СтрокаФайла.Дата = Данные.Дата;
	СтрокаФайла.Контрагент = Данные.Покупатель.Наименование;
	СтрокаФайла.ИНН = Данные.Покупатель.ИНН;
	СтрокаФайла.Сумма = Формат(Данные.Сумма, "ЧДЦ=2; ЧГ=0");
	СтрокаФайла.НДС = Формат(Данные.СуммаНДС, "ЧДЦ=2; ЧГ=0");
	СтрокаФайла.Статус = "Разобран";
	Если Данные.Предупреждения.Количество() > 0 Тогда
		СтрокаФайла.Ошибка = СтрСоединить(Данные.Предупреждения, " ");
	КонецЕсли;

	Для Каждого УжеЕсть Из Файлы Цикл
		Если УжеЕсть = СтрокаФайла Тогда
			Продолжить;
		КонецЕсли;
		Если УжеЕсть.Номер = СтрокаФайла.Номер И УжеЕсть.Дата = СтрокаФайла.Дата И УжеЕсть.ИНН = СтрокаФайла.ИНН
			И УжеЕсть.Статус <> "Ошибка" Тогда
			СтрокаФайла.Статус = "Дубль";
			СтрокаФайла.Ошибка = "Такой номер, дата и ИНН уже есть в списке.";
			СтрокаФайла.СоздатьСчет = Ложь;
			СтрокаФайла.СоздатьУПД = Ложь;
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

&НаСервере
Функция СоздатьДокументыНаСервере()

	Если Не ПравоДоступа("Использование", Метаданные.Обработки.ЗС_ЗагрузкаСчетовИзPDF) Тогда
		ВызватьИсключение "Недостаточно прав. Назначьте роль «Загрузка счетов и УПД из PDF».";
	КонецЕсли;

	ПротоколСтроки = Новый Массив;
	Создано = 0;
	Ошибок = 0;
	Пропущено = 0;
	Для Каждого СтрокаФайла Из Файлы Цикл
		Если СтрокаФайла.Статус <> "Разобран" Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Не СтрокаФайла.СоздатьСчет И Не СтрокаФайла.СоздатьУПД Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(СтрокаФайла.Данные);
			Данные = ПрочитатьJSON(Чтение);
			Данные.Номер = СокрЛП(СтрокаФайла.Номер);
			Данные.Дата = СокрЛП(СтрокаФайла.Дата);
			Данные.Покупатель.Наименование = СокрЛП(СтрокаФайла.Контрагент);
			Данные.Покупатель.ИНН = СокрЛП(СтрокаФайла.ИНН);
			ТекстСуммы = СтрЗаменить(СтрокаФайла.Сумма, " ", "");
			ТекстСуммы = СтрЗаменить(ТекстСуммы, ".", ",");
			Данные.Сумма = Число(ТекстСуммы);
			Если Данные.СтавкаНДС > 0 Тогда
				Данные.СуммаНДС = Окр(Данные.Сумма * Данные.СтавкаНДС / (100 + Данные.СтавкаНДС), 2);
			КонецЕсли;
			Данные.Вставить("СоздатьСчет", СтрокаФайла.СоздатьСчет);
			Данные.Вставить("СоздатьУПД", СтрокаФайла.СоздатьУПД);
			Запись = Новый ЗаписьJSON;
			Запись.УстановитьСтроку();
			ЗаписатьJSON(Запись, Данные);
			Текст = ЗС_ЗагрузкаСчетовСервер.СоздатьДокументы(Запись.Закрыть());
			СтрокаФайла.Статус = "Создан";
			СтрокаФайла.Ошибка = "";
			Создано = Создано + 1;
			ПротоколСтроки.Добавить(СтрокаФайла.ИмяФайла + ":" + Символы.ПС + Текст);
		Исключение
			СтрокаФайла.Статус = "Ошибка";
			СтрокаФайла.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Ошибок = Ошибок + 1;
			ПротоколСтроки.Добавить(СтрокаФайла.ИмяФайла + ": " + СтрокаФайла.Ошибка);
		КонецПопытки;
	КонецЦикла;

	Протокол = СтрСоединить(ПротоколСтроки, Символы.ПС + Символы.ПС);
	Возврат "Создано: " + Формат(Создано, "ЧГ=0")
		+ ", ошибок: " + Формат(Ошибок, "ЧГ=0")
		+ ", пропущено: " + Формат(Пропущено, "ЧГ=0")
		+ Символы.ПС + Символы.ПС + Протокол;

КонецФункции

#КонецОбласти
