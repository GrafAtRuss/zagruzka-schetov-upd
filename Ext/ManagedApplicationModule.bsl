// Один раз показывает раздел «Загрузка PDF» в панели разделов
// пользователю, которому назначена роль загрузки.

&НаКлиенте
&После("ПриНачалеРаботыСистемы")
Процедура ЗС_ПриНачалеРаботыСистемы()

	Если ЗС_ПоказатьРазделНаСервере() Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗС_ПоказатьРазделНаСервере()

	Если Не ПравоДоступа("Просмотр", Метаданные.Подсистемы.ЗС_ЗагрузкаДокументов) Тогда
		Возврат Ложь;
	КонецЕсли;

	КлючФлага = "ЗС/РазделВПанели";
	Попытка
		Если ХранилищеСистемныхНастроек.Загрузить(КлючФлага) = Истина Тогда
			Возврат Ложь;
		КонецЕсли;
		ХранилищеСистемныхНастроек.Удалить("Общее/ПанельРазделов/НастройкиКомандногоИнтерфейса");
		ХранилищеСистемныхНастроек.Сохранить(КлючФлага, "", Истина);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции
