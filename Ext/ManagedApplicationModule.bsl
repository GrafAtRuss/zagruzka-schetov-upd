// Один раз показывает раздел «Загрузка PDF» в панели разделов
// пользователю, которому назначена роль загрузки.
// Серверный вызов только через общий модуль: в модуле приложения расширения
// свои процедуры &НаСервере платформа не компилирует.

&НаКлиенте
&После("ПриНачалеРаботыСистемы")
Процедура ЗС_ПриНачалеРаботыСистемы()

	Попытка
		Если ЗС_ЗагрузкаСчетовСервер.ПоказатьРаздел() Тогда
			ОбновитьИнтерфейс();
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;

КонецПроцедуры
