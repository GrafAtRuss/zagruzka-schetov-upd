
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайлы(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.МножественныйВыбор = Истина;
	ПараметрыДиалога.Фильтр = "Документы PDF (*.pdf)|*.pdf";
	ПараметрыДиалога.Заголовок = "Счета и УПД";
	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайлов", ЭтотОбъект);
	НачатьПомещениеФайловНаСервер(Оповещение, , , , ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайлов(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПомещенныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ПомещенныйФайл Из ПомещенныеФайлы Цикл
		Если ПомещенныйФайл.ПомещениеФайлаОтменено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьФайлНаСервере(ПомещенныйФайл.Адрес, ПомещенныйФайл.СсылкаНаФайл.Имя);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументы(Команда)

	Текст = СоздатьДокументыНаСервере();
	Если ЗначениеЗаполнено(Текст) Тогда
		ПоказатьПредупреждение(, Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)

	Файлы.Очистить();
	Протокол = "";

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьФайлНаСервере(Адрес, ИмяФайла)

	Если Не ПравоДоступа("Использование", Метаданные.Обработки.ЗС_ЗагрузкаСчетовИзPDF) Тогда
		ВызватьИсключение "Недостаточно прав. Назначьте роль «Загрузка счетов и УПД из PDF».";
	КонецЕсли;

	ДанныеФайла = ПолучитьИзВременногоХранилища(Адрес);
	ТекстJSON = ЗС_ЗагрузкаСчетовСервер.РазобратьPDF(ДанныеФайла);
	СтрокаФайла = Файлы.Добавить();
	СтрокаФайла.ИмяФайла = ИмяФайла;
	СтрокаФайла.Данные = ТекстJSON;
	СтрокаФайла.СоздатьСчет = Истина;
	СтрокаФайла.СоздатьУПД = Истина;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Попытка
		Данные = ПрочитатьJSON(Чтение);
	Исключение
		СтрокаФайла.Статус = "Ошибка";
		СтрокаФайла.Ошибка = "Ответ разбора не является JSON.";
		Возврат;
	КонецПопытки;

	Если Данные.Свойство("Ошибка") И ЗначениеЗаполнено(Данные.Ошибка) Тогда
		СтрокаФайла.Статус = "Ошибка";
		СтрокаФайла.Ошибка = Данные.Ошибка;
		Возврат;
	КонецЕсли;

	СтрокаФайла.Вид = Данные.Вид;
	СтрокаФайла.Номер = Данные.Номер;
	СтрокаФайла.Дата = Данные.Дата;
	СтрокаФайла.Контрагент = Данные.Покупатель.Наименование;
	СтрокаФайла.ИНН = Данные.Покупатель.ИНН;
	СтрокаФайла.Сумма = Формат(Данные.Сумма, "ЧДЦ=2; ЧГ=0");
	СтрокаФайла.НДС = Формат(Данные.СуммаНДС, "ЧДЦ=2; ЧГ=0");
	СтрокаФайла.Статус = "Разобран";
	Если Данные.Предупреждения.Количество() > 0 Тогда
		СтрокаФайла.Ошибка = СтрСоединить(Данные.Предупреждения, " ");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СоздатьДокументыНаСервере()

	Если Не ПравоДоступа("Использование", Метаданные.Обработки.ЗС_ЗагрузкаСчетовИзPDF) Тогда
		ВызватьИсключение "Недостаточно прав. Назначьте роль «Загрузка счетов и УПД из PDF».";
	КонецЕсли;

	ПротоколСтроки = Новый Массив;
	Для Каждого СтрокаФайла Из Файлы Цикл
		Если СтрокаФайла.Статус <> "Разобран" Тогда
			Продолжить;
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(СтрокаФайла.Данные);
		Данные = ПрочитатьJSON(Чтение);
		Данные.Номер = СокрЛП(СтрокаФайла.Номер);
		Данные.Дата = СокрЛП(СтрокаФайла.Дата);
		Данные.Покупатель.Наименование = СокрЛП(СтрокаФайла.Контрагент);
		Данные.Покупатель.ИНН = СокрЛП(СтрокаФайла.ИНН);
		ТекстСуммы = СтрЗаменить(СтрокаФайла.Сумма, " ", "");
		ТекстСуммы = СтрЗаменить(ТекстСуммы, ".", ",");
		Данные.Сумма = Число(ТекстСуммы);
		Если Данные.СтавкаНДС > 0 Тогда
			Данные.СуммаНДС = Окр(Данные.Сумма * Данные.СтавкаНДС / (100 + Данные.СтавкаНДС), 2);
		КонецЕсли;
		Данные.Вставить("СоздатьСчет", СтрокаФайла.СоздатьСчет);
		Данные.Вставить("СоздатьУПД", СтрокаФайла.СоздатьУПД);
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Данные);
		Попытка
			Текст = ЗС_ЗагрузкаСчетовСервер.СоздатьДокументы(Запись.Закрыть());
			СтрокаФайла.Статус = "Создан";
			СтрокаФайла.Ошибка = "";
			ПротоколСтроки.Добавить(СтрокаФайла.ИмяФайла + ":" + Символы.ПС + Текст);
		Исключение
			СтрокаФайла.Статус = "Ошибка";
			СтрокаФайла.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ПротоколСтроки.Добавить(СтрокаФайла.ИмяФайла + ": " + СтрокаФайла.Ошибка);
		КонецПопытки;
	КонецЦикла;

	Протокол = СтрСоединить(ПротоколСтроки, Символы.ПС + Символы.ПС);
	Возврат Протокол;

КонецФункции

#КонецОбласти
